# Copy this file to .env on the QA VPS before:
#   docker compose --env-file .env -f docker-compose.qa.yml up -d --build
#
# Generate passwords with: openssl rand -hex 32
# Do not reuse the local values (eden_bowls / root).

NODE_ENV=production
PORT=3000
MODE=http
LOG_LEVEL=info
BACKEND_HTTP_PORT=3000

# Same origin as /qa-app and /qa-admin on edenbowls.com
CORS_ORIGINS=https://edenbowls.com,https://www.edenbowls.com

# docker-compose.qa.yml puts API and MySQL on the same network.
# DB_HOST/DB_PORT below are overridden to db:3306 inside the API container.
DB_HOST=db
DB_PORT=3306
DB_USER=eden_bowls
DB_PASSWORD=
DB_NAME=eden_bowls
MYSQL_ROOT_PASSWORD=
BREEDS_TABLE_NAME=wp_hsr_breeds

JWT_AUTH_SECRET_KEY=change-this-in-production
JWT_AUTH_ALGORITHM=HS256
JWT_AUTH_EXPIRES_IN_SECONDS=900
JWT_AUTH_ISSUER=https://edenbowls.com/qa-api

# Public Caddy strips /qa-api before proxying. Cookie Path must stay on the
# browser-visible prefix so refresh works from https://edenbowls.com/qa-app.
AUTH_REFRESH_TOKEN_TTL_SECONDS=2592000
AUTH_REFRESH_COOKIE_NAME=eden_refresh_token
AUTH_REFRESH_COOKIE_PATH=/qa-api/api/v1/auth
AUTH_REFRESH_COOKIE_SAME_SITE=lax
AUTH_REFRESH_COOKIE_SECURE=true

AUTH_OTP_TTL_SECONDS=600
AUTH_OTP_MAX_ATTEMPTS=5
AUTH_OTP_RESEND_MAX_ATTEMPTS=3
AUTH_OTP_RESEND_WINDOW_SECONDS=3600
AUTH_OTP_PEPPER=

AUTH_SMTP_HOST=smtp-relay.brevo.com
AUTH_SMTP_PORT=587
AUTH_SMTP_USER=
AUTH_SMTP_PASS=
AUTH_SMTP_ENCRYPTION=tls
AUTH_SMTP_AUTH=true
AUTH_MAIL_FROM=
AUTH_MAIL_FROM_NAME=Eden Bowls

STRIPE_SECRET_KEY=
STRIPE_API_VERSION=2025-09-30.clover
STRIPE_MAX_RETRIES=2
STRIPE_US_AUTOMATIC_TAX=true
STRIPE_SHIPPING_PRODUCT_ID=
STRIPE_WEBHOOK_SECRET=

NOMINATIM_USER_AGENT=EdenBowlShipping/1.0 (https://edenbowl.com; shipping@edenbowl.com)

ADMIN_EMAILS=

GEO_MAXMIND_DB_PATH=./data/GeoLite2-Country.mmdb
GEO_TRUST_PROXY_HEADERS=true
TRUST_PROXY=true

PROFILE_AVATAR_DIR=./public/avatars
PROFILE_AVATAR_PUBLIC_BASE_URL=https://edenbowls.com/qa-api/avatars
FEEDBACK_PHOTO_DIR=./public/feedback-photos
FEEDBACK_PHOTO_PUBLIC_BASE_URL=https://edenbowls.com/qa-api/feedback-photos
