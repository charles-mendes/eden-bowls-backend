{
  "name": "eden-bowls-backend",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "migrate": "node src/scripts/run-migrations.js",
    "test": "jest --runInBand",
    "test:unit": "jest --runInBand",
    "test:integration": "RUN_DB_INTEGRATION_TESTS=true jest --runInBand --testPathPattern=tests/integration",
    "test:related": "jest --findRelatedTests",
    "test:changed": "jest --changedSince=HEAD"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.1",
    "helmet": "^8.0.0",
    "luxon": "^3.5.0",
    "mysql2": "^3.11.3",
    "pino": "^9.4.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^0.3.24",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.0.0"
  }
}
