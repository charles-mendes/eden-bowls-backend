{
  email {$LETSENCRYPT_EMAIL}
  auto_https disable_redirects
  key_type rsa2048
  servers {
    protocols h1 h2
  }
}

(qa_noindex) {
  header X-Robots-Tag "noindex, nofollow"
}

(qa_robots) {
  handle /robots.txt {
    header Content-Type "text/plain; charset=utf-8"
    respond "User-agent: *\nDisallow: /\n" 200
  }
}

(security_headers) {
  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    Content-Security-Policy "upgrade-insecure-requests"
    Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
    Cross-Origin-Opener-Policy "same-origin"
    Cross-Origin-Resource-Policy "same-origin"
    X-Permitted-Cross-Domain-Policies "none"
    Alt-Svc "clear"
    X-Content-Type-Options "nosniff"
    X-Frame-Options "SAMEORIGIN"
    Referrer-Policy "strict-origin-when-cross-origin"
  }
}

(legacy_qa_redirects) {
  @old_qa_app path /qa-app /qa-app/*
  handle @old_qa_app {
    uri strip_prefix /qa-app
    redir https://qa.edenbowls.com{uri} 308
  }

  @old_qa_admin path /qa-admin /qa-admin/*
  handle @old_qa_admin {
    uri strip_prefix /qa-admin
    redir https://qa-admin.edenbowls.com{uri} 308
  }

  @old_qa_api path /qa-api /qa-api/*
  handle @old_qa_api {
    uri strip_prefix /qa-api
    redir https://qa-api.edenbowls.com{uri} 308
  }
}

(landing_static_cache) {
  @public_media path /favicon.ico /favicon-16x16.png /favicon-32x32.png /apple-touch-icon.png /fonts/*
  header @public_media Cache-Control "public, max-age=604800"
}

http://edenbowls.com, http://www.edenbowls.com, http://edenbowls.com.br, http://www.edenbowls.com.br, http://qa.edenbowls.com, http://qa-admin.edenbowls.com, http://qa-api.edenbowls.com {
  @not_acme not path /.well-known/acme-challenge/*
  redir @not_acme https://{host}{uri} 301
}

www.edenbowls.com {
  encode zstd gzip
  import security_headers
  import legacy_qa_redirects

  handle {
    redir https://edenbowls.com{uri} 301
  }
}

edenbowls.com {
  encode zstd gzip
  import security_headers
  import legacy_qa_redirects
  import landing_static_cache
  header Link "</sitemap.xml>; rel=\"sitemap\""

  handle {
    root * /srv/edenbowls
    @root_index_com path /
    rewrite @root_index_com /index.html
    file_server
  }
}

qa.edenbowls.com {
  encode zstd gzip
  import qa_noindex
  import security_headers
  import qa_robots

  handle {
    reverse_proxy {$FRONTEND_UPSTREAM} {
      header_up Host {host}
      header_up X-Forwarded-Host {host}
      header_up X-Forwarded-Proto {scheme}
      header_up X-Forwarded-Uri {uri}
    }
  }
}

qa-admin.edenbowls.com {
  encode zstd gzip
  import qa_noindex
  import security_headers
  import qa_robots

  handle {
    reverse_proxy {$ADMIN_UPSTREAM} {
      header_up Host {host}
      header_up X-Forwarded-Host {host}
      header_up X-Forwarded-Proto {scheme}
      header_up X-Forwarded-Uri {uri}
    }
  }
}

qa-api.edenbowls.com {
  encode zstd gzip
  import qa_noindex
  import security_headers
  import qa_robots

  handle {
    reverse_proxy {$API_UPSTREAM} {
      header_up Host {host}
      header_up X-Forwarded-Host {host}
      header_up X-Forwarded-Proto {scheme}
      header_up X-Forwarded-Uri {uri}
    }
  }
}

www.edenbowls.com.br {
  encode zstd gzip
  import security_headers

  handle {
    redir https://edenbowls.com.br{uri} 301
  }
}

edenbowls.com.br {
  encode zstd gzip
  import security_headers
  import landing_static_cache
  header Link "</sitemap.xml>; rel=\"sitemap\""

  handle /robots.txt {
    header Content-Type "text/plain; charset=utf-8"
    root * /srv/edenbowls
    rewrite * /robots-br.txt
    file_server
  }

  handle /sitemap.xml {
    header Content-Type "application/xml; charset=utf-8"
    root * /srv/edenbowls
    rewrite * /sitemap-br.xml
    file_server
  }

  handle {
    root * /srv/edenbowls
    @root_index_combr path /
    rewrite @root_index_combr /index-br.html
    file_server
  }
}
