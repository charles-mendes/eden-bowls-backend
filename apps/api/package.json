{
  "name": "@eden-bowls/api",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:dev": "tsx watch src/main.ts",
    "test": "jest --config jest.config.cjs --passWithNoTests",
    "test:e2e": "jest --config jest.e2e.config.cjs --runInBand --passWithNoTests",
    "test:e2e:bootstrap": "DATABASE_URL=${DATABASE_URL:-mysql://root:root@127.0.0.1:3307/eden_bowls} JWT_ACCESS_SECRET=${JWT_ACCESS_SECRET:-e2e-access-secret} JWT_REFRESH_SECRET=${JWT_REFRESH_SECRET:-e2e-refresh-secret} RUN_E2E=1 sh -c 'npx prisma db push && npm run test:e2e'",
    "test:emails": "jest --config jest.config.cjs src/modules/emails --runInBand",
    "db:format": "prisma format",
    "db:generate": "prisma generate",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.9",
    "@nestjs/config": "^3.2.3",
    "@nestjs/core": "^10.4.9",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/platform-express": "^10.4.9",
    "@prisma/client": "^6.10.1",
    "argon2": "^0.40.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/testing": "^10.4.9",
    "@types/supertest": "^6.0.3",
    "@types/jest": "^29.5.12",
    "jest": "^29.7.0",
    "prisma": "^6.10.1",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "tsx": "^4.16.2",
    "typescript": "^5.5.4"
  }
}