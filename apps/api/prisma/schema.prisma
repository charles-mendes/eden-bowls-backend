generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  pending
  active
  blocked
}

enum OtpPurpose {
  register
  password_reset
}

model User {
  id              String     @id @default(uuid()) @db.Char(36)
  email           String     @unique @db.VarChar(191)
  passwordHash    String     @map("password_hash") @db.VarChar(255)
  status          UserStatus @default(pending)
  emailVerifiedAt DateTime?  @map("email_verified_at") @db.DateTime(3)
  lastLoginAt     DateTime?  @map("last_login_at") @db.DateTime(3)
  createdAt       DateTime   @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt       DateTime   @updatedAt @map("updated_at") @db.DateTime(3)

  userRoles            UserRole[]
  refreshTokens        RefreshToken[]
  otpChallenges        OtpChallenge[]
  profile              UserProfile?
  addresses            UserAddress[]
  pets                 Pet[]
  onboardingSessions   OnboardingSession[]
  subscriptions        Subscription[]
  checkoutOrders       CheckoutOrder[]
  orders               Order[]
  orderStatusHistories OrderStatusHistory[]
  stripeCustomers      StripeCustomer[]

  @@map("users")
}

enum AddressType {
  billing
  shipping
}

enum PetSpecies {
  dog
  cat
}

enum PetSex {
  male
  female
  unknown
}

enum SubscriptionProvider {
  stripe
}

enum SubscriptionStatus {
  active
  paused
  past_due
  cancelled
}

enum SubscriptionEventSource {
  api
  webhook
  system
}

enum CheckoutOrderStatus {
  draft
  pending_payment
  paid
  failed
  cancelled
}

enum OrderStatus {
  new
  confirmed
  preparing
  shipped
  delivered
  cancelled
}

enum WebhookState {
  processing
  processed
  failed
}

enum EmailMessageStatus {
  queued
  sent
  failed
}

enum ShippingProvider {
  manual_local
  usps
  correios
  melhor_envio
  custom
}

enum OnboardingStatus {
  started
  in_progress
  ready_for_checkout
  completed
  abandoned
}

model Role {
  id        String   @id @default(uuid()) @db.Char(36)
  code      String   @unique @db.VarChar(64)
  name      String   @db.VarChar(128)
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@map("roles")
}

model Permission {
  id        String   @id @default(uuid()) @db.Char(36)
  resource  String   @db.VarChar(100)
  action    String   @db.VarChar(100)
  code      String   @unique @db.VarChar(200)
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  id           String @id @default(uuid()) @db.Char(36)
  roleId       String @map("role_id") @db.Char(36)
  permissionId String @map("permission_id") @db.Char(36)

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model UserRole {
  id     String @id @default(uuid()) @db.Char(36)
  userId String @map("user_id") @db.Char(36)
  roleId String @map("role_id") @db.Char(36)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Char(36)
  userId    String    @map("user_id") @db.Char(36)
  tokenHash String    @map("token_hash") @db.VarChar(255)
  familyId  String    @map("family_id") @db.VarChar(128)
  revokedAt DateTime? @map("revoked_at") @db.DateTime(3)
  expiresAt DateTime  @map("expires_at") @db.DateTime(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.DateTime(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([familyId])
  @@map("refresh_tokens")
}

model OtpChallenge {
  id          String     @id @default(uuid()) @db.Char(36)
  userId      String     @map("user_id") @db.Char(36)
  otpHash     String     @map("otp_hash") @db.VarChar(255)
  purpose     OtpPurpose
  attempts    Int        @default(0)
  resendCount Int        @default(0) @map("resend_count")
  consumedAt  DateTime?  @map("consumed_at") @db.DateTime(3)
  expiresAt   DateTime   @map("expires_at") @db.DateTime(3)
  createdAt   DateTime   @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt   DateTime   @updatedAt @map("updated_at") @db.DateTime(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose, expiresAt])
  @@map("otp_challenges")
}

model IdempotencyKey {
  id           String   @id @default(uuid()) @db.Char(36)
  scope        String   @db.VarChar(120)
  key          String   @db.VarChar(191)
  requestHash  String   @map("request_hash") @db.VarChar(255)
  responseJson Json?    @map("response_json")
  statusCode   Int?     @map("status_code")
  expiresAt    DateTime @map("expires_at") @db.DateTime(3)
  createdAt    DateTime @default(now()) @map("created_at") @db.DateTime(3)

  @@unique([scope, key])
  @@index([expiresAt])
  @@map("idempotency_keys")
}

model BusinessRulesConfig {
  id            String    @id @default(uuid()) @db.Char(36)
  domain        String    @db.VarChar(120)
  key           String    @db.VarChar(120)
  marketCountry String?   @map("market_country") @db.VarChar(2)
  valueJson     Json      @map("value_json")
  active        Boolean   @default(true)
  effectiveFrom DateTime  @map("effective_from") @db.DateTime(3)
  effectiveTo   DateTime? @map("effective_to") @db.DateTime(3)
  createdAt     DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.DateTime(3)

  @@unique([domain, key, marketCountry, effectiveFrom])
  @@map("business_rules_config")
}

model AuditLog {
  id            String   @id @default(uuid()) @db.Char(36)
  actorUserId   String?  @map("actor_user_id") @db.Char(36)
  actorRole     String?  @map("actor_role") @db.VarChar(64)
  action        String   @db.VarChar(120)
  resource      String   @db.VarChar(120)
  resourceId    String   @map("resource_id") @db.VarChar(120)
  beforeJson    Json?    @map("before_json")
  afterJson     Json?    @map("after_json")
  correlationId String?  @map("correlation_id") @db.VarChar(120)
  createdAt     DateTime @default(now()) @map("created_at") @db.DateTime(3)

  @@index([resource, resourceId, createdAt])
  @@index([actorUserId, createdAt])
  @@map("audit_logs")
}

model Category {
  id        String   @id @default(uuid()) @db.Char(36)
  slug      String   @unique @db.VarChar(120)
  namePt    String   @map("name_pt") @db.VarChar(150)
  nameEn    String   @map("name_en") @db.VarChar(150)
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  products Product[]

  @@index([active])
  @@map("categories")
}

model Product {
  id            String   @id @default(uuid()) @db.Char(36)
  categoryId    String   @map("category_id") @db.Char(36)
  slug          String   @unique @db.VarChar(120)
  namePt        String   @map("name_pt") @db.VarChar(150)
  nameEn        String   @map("name_en") @db.VarChar(150)
  descriptionPt String?  @map("description_pt") @db.VarChar(2000)
  descriptionEn String?  @map("description_en") @db.VarChar(2000)
  active        Boolean  @default(true)
  createdAt     DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  category           Category              @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  variants           ProductVariant[]
  marketConfigs      ProductMarketConfig[]
  checkoutOrderItems CheckoutOrderItem[]

  @@index([categoryId, active])
  @@map("products")
}

model ProductVariant {
  id          String   @id @default(uuid()) @db.Char(36)
  productId   String   @map("product_id") @db.Char(36)
  sku         String   @unique @db.VarChar(120)
  flavorKey   String   @map("flavor_key") @db.VarChar(120)
  weightLabel String   @map("weight_label") @db.VarChar(80)
  grams       Int
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  product            Product                 @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantPrices      VariantPrice[]
  subscriptionItems  SubscriptionItem[]
  checkoutOrderItems CheckoutOrderItem[]
  stripePriceMaps    StripeProductPriceMap[]

  @@index([productId, active])
  @@map("product_variants")
}

model ProductMarketConfig {
  id            String   @id @default(uuid()) @db.Char(36)
  productId     String   @map("product_id") @db.Char(36)
  marketCountry String   @map("market_country") @db.VarChar(2)
  currency      String   @db.VarChar(3)
  planDays      Int      @map("plan_days")
  isPlanProduct Boolean  @default(false) @map("is_plan_product")
  active        Boolean  @default(true)
  createdAt     DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, marketCountry, currency])
  @@index([marketCountry, currency, active])
  @@map("product_market_config")
}

model VariantPrice {
  id           String    @id @default(uuid()) @db.Char(36)
  variantId    String    @map("variant_id") @db.Char(36)
  currency     String    @db.VarChar(3)
  regularPrice Decimal   @map("regular_price") @db.Decimal(12, 2)
  salePrice    Decimal?  @map("sale_price") @db.Decimal(12, 2)
  saleFrom     DateTime? @map("sale_from") @db.DateTime(3)
  saleTo       DateTime? @map("sale_to") @db.DateTime(3)
  source       String    @db.VarChar(80)
  createdAt    DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.DateTime(3)

  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([variantId, currency])
  @@index([currency, saleFrom, saleTo])
  @@map("variant_prices")
}

model SubscriptionTerm {
  id              String    @id @default(uuid()) @db.Char(36)
  marketCountry   String    @map("market_country") @db.VarChar(2)
  months          Int
  discountPercent Decimal   @map("discount_percent") @db.Decimal(5, 2)
  active          Boolean   @default(true)
  effectiveFrom   DateTime  @map("effective_from") @db.DateTime(3)
  effectiveTo     DateTime? @map("effective_to") @db.DateTime(3)
  createdAt       DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.DateTime(3)

  subscriptions Subscription[]

  @@index([marketCountry, months, active, effectiveFrom], map: "sub_terms_country_months_active_eff_from_idx")
  @@map("subscription_terms")
}

model ShippingQuote {
  id                  String           @id @default(uuid()) @db.Char(36)
  sessionId           String           @map("session_id") @db.Char(36)
  provider            ShippingProvider
  destinationCountry  String           @map("destination_country") @db.VarChar(2)
  destinationPostcode String           @map("destination_postcode") @db.VarChar(30)
  currency            String           @db.VarChar(3)
  subtotal            Decimal          @db.Decimal(12, 2)
  selectedRateId      String?          @map("selected_rate_id") @db.Char(36)
  expiresAt           DateTime         @map("expires_at") @db.DateTime(3)
  createdAt           DateTime         @default(now()) @map("created_at") @db.DateTime(3)

  rates ShippingQuoteRate[]

  @@index([sessionId, expiresAt])
  @@index([provider, expiresAt])
  @@map("shipping_quotes")
}

model ShippingQuoteRate {
  id             String   @id @default(uuid()) @db.Char(36)
  quoteId        String   @map("quote_id") @db.Char(36)
  externalRateId String?  @map("external_rate_id") @db.VarChar(120)
  serviceCode    String   @map("service_code") @db.VarChar(80)
  serviceLabel   String   @map("service_label") @db.VarChar(160)
  amount         Decimal  @db.Decimal(12, 2)
  etaMinDays     Int?     @map("eta_min_days")
  etaMaxDays     Int?     @map("eta_max_days")
  rawJson        Json?    @map("raw_json")
  createdAt      DateTime @default(now()) @map("created_at") @db.DateTime(3)

  quote ShippingQuote @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([quoteId])
  @@map("shipping_quote_rates")
}

model Subscription {
  id                     String               @id @default(uuid()) @db.Char(36)
  userId                 String               @map("user_id") @db.Char(36)
  orderId                String?              @map("order_id") @db.Char(36)
  provider               SubscriptionProvider @default(stripe)
  providerSubscriptionId String               @unique @map("provider_subscription_id") @db.VarChar(120)
  status                 SubscriptionStatus
  autoRenew              Boolean              @default(true) @map("auto_renew")
  termId                 String               @map("term_id") @db.Char(36)
  startAt                DateTime             @map("start_at") @db.DateTime(3)
  endAt                  DateTime?            @map("end_at") @db.DateTime(3)
  nextBillingAt          DateTime?            @map("next_billing_at") @db.DateTime(3)
  nextShipmentAt         DateTime?            @map("next_shipment_at") @db.DateTime(3)
  recurrenceJson         Json                 @map("recurrence_json")
  planSnapshotJson       Json                 @map("plan_snapshot_json")
  createdAt              DateTime             @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt              DateTime             @updatedAt @map("updated_at") @db.DateTime(3)

  user            User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  term            SubscriptionTerm    @relation(fields: [termId], references: [id], onDelete: Restrict)
  checkoutOrder   CheckoutOrder?      @relation(fields: [orderId], references: [id], onDelete: SetNull)
  items           SubscriptionItem[]
  events          SubscriptionEvent[]
  paymentAttempts PaymentAttempt[]

  @@index([userId, status, nextBillingAt])
  @@index([termId])
  @@map("subscriptions")
}

model CheckoutOrder {
  id             String              @id @default(uuid()) @db.Char(36)
  sessionId      String?             @map("session_id") @db.Char(36)
  userId         String              @map("user_id") @db.Char(36)
  planSnapshotId String?             @map("plan_snapshot_id") @db.Char(36)
  status         CheckoutOrderStatus @default(draft)
  currency       String              @db.VarChar(3)
  subtotal       Decimal             @db.Decimal(12, 2)
  shippingTotal  Decimal             @map("shipping_total") @db.Decimal(12, 2)
  total          Decimal             @db.Decimal(12, 2)
  paymentState   String              @map("payment_state") @db.VarChar(80)
  metadataJson   Json?               @map("metadata_json")
  createdAt      DateTime            @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime            @updatedAt @map("updated_at") @db.DateTime(3)

  user              User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  onboardingSession OnboardingSession?          @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  planSnapshot      PlanSnapshot?               @relation(fields: [planSnapshotId], references: [id], onDelete: SetNull)
  items             CheckoutOrderItem[]
  shippingSelection CheckoutShippingSelection[]
  orders            Order[]
  subscriptions     Subscription[]

  @@index([userId, status, createdAt])
  @@map("checkout_orders")
}

model CheckoutOrderItem {
  id          String   @id @default(uuid()) @db.Char(36)
  orderId     String   @map("order_id") @db.Char(36)
  productId   String   @map("product_id") @db.Char(36)
  variantId   String   @map("variant_id") @db.Char(36)
  quantity    Int
  unitPrice   Decimal  @map("unit_price") @db.Decimal(12, 2)
  lineTotal   Decimal  @map("line_total") @db.Decimal(12, 2)
  payloadJson Json?    @map("payload_json")
  createdAt   DateTime @default(now()) @map("created_at") @db.DateTime(3)

  order   CheckoutOrder  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product        @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([productId])
  @@index([variantId])
  @@map("checkout_order_items")
}

model CheckoutShippingSelection {
  id        String   @id @default(uuid()) @db.Char(36)
  orderId   String   @map("order_id") @db.Char(36)
  quoteId   String?  @map("quote_id") @db.Char(36)
  rateId    String?  @map("rate_id") @db.Char(36)
  label     String   @db.VarChar(160)
  cost      Decimal  @db.Decimal(12, 2)
  taxTotal  Decimal  @map("tax_total") @db.Decimal(12, 2)
  total     Decimal  @db.Decimal(12, 2)
  rawJson   Json?    @map("raw_json")
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)

  order CheckoutOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("checkout_shipping_selection")
}

model Order {
  id              String      @id @default(uuid()) @db.Char(36)
  checkoutOrderId String      @map("checkout_order_id") @db.Char(36)
  userId          String      @map("user_id") @db.Char(36)
  status          OrderStatus @default(new)
  createdAt       DateTime    @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt       DateTime    @updatedAt @map("updated_at") @db.DateTime(3)

  checkoutOrder CheckoutOrder        @relation(fields: [checkoutOrderId], references: [id], onDelete: Cascade)
  user          User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  statusHistory OrderStatusHistory[]

  @@index([userId, status, createdAt])
  @@index([checkoutOrderId])
  @@map("orders")
}

model OrderStatusHistory {
  id              String       @id @default(uuid()) @db.Char(36)
  orderId         String       @map("order_id") @db.Char(36)
  fromStatus      OrderStatus? @map("from_status")
  toStatus        OrderStatus  @map("to_status")
  reason          String?      @db.VarChar(255)
  changedByUserId String?      @map("changed_by_user_id") @db.Char(36)
  createdAt       DateTime     @default(now()) @map("created_at") @db.DateTime(3)

  order         Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  changedByUser User? @relation(fields: [changedByUserId], references: [id], onDelete: SetNull)

  @@index([orderId, createdAt])
  @@index([changedByUserId])
  @@map("order_status_history")
}

model SubscriptionItem {
  id             String   @id @default(uuid()) @db.Char(36)
  subscriptionId String   @map("subscription_id") @db.Char(36)
  variantId      String   @map("variant_id") @db.Char(36)
  quantity       Int
  unitPrice      Decimal  @map("unit_price") @db.Decimal(12, 2)
  lineTotal      Decimal  @map("line_total") @db.Decimal(12, 2)
  createdAt      DateTime @default(now()) @map("created_at") @db.DateTime(3)

  subscription Subscription   @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  variant      ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@index([subscriptionId])
  @@index([variantId])
  @@map("subscription_items")
}

model SubscriptionEvent {
  id             String                  @id @default(uuid()) @db.Char(36)
  subscriptionId String                  @map("subscription_id") @db.Char(36)
  source         SubscriptionEventSource
  eventType      String                  @map("event_type") @db.VarChar(120)
  payloadJson    Json?                   @map("payload_json")
  createdAt      DateTime                @default(now()) @map("created_at") @db.DateTime(3)

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId, createdAt])
  @@map("subscription_events")
}

model PaymentAttempt {
  id             String    @id @default(uuid()) @db.Char(36)
  subscriptionId String    @map("subscription_id") @db.Char(36)
  invoiceRef     String?   @map("invoice_ref") @db.VarChar(120)
  attemptNumber  Int       @map("attempt_number")
  status         String    @db.VarChar(60)
  failureCode    String?   @map("failure_code") @db.VarChar(120)
  nextRetryAt    DateTime? @map("next_retry_at") @db.DateTime(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.DateTime(3)

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId, status, nextRetryAt])
  @@map("payment_attempts")
}

model StripeCustomer {
  id               String   @id @default(uuid()) @db.Char(36)
  userId           String   @map("user_id") @db.Char(36)
  stripeCustomerId String   @unique @map("stripe_customer_id") @db.VarChar(120)
  email            String   @db.VarChar(191)
  metadataJson     Json?    @map("metadata_json")
  createdAt        DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  user           User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  paymentMethods StripePaymentMethod[]

  @@index([userId])
  @@map("stripe_customers")
}

model StripePaymentMethod {
  id                    String   @id @default(uuid()) @db.Char(36)
  stripeCustomerRefId   String   @map("stripe_customer_ref_id") @db.Char(36)
  stripePaymentMethodId String   @unique @map("stripe_payment_method_id") @db.VarChar(120)
  brand                 String?  @db.VarChar(50)
  last4                 String?  @db.VarChar(4)
  expMonth              Int?     @map("exp_month")
  expYear               Int?     @map("exp_year")
  isDefault             Boolean  @default(false) @map("is_default")
  createdAt             DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt             DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  customer StripeCustomer @relation(fields: [stripeCustomerRefId], references: [id], onDelete: Cascade)

  @@index([stripeCustomerRefId, isDefault])
  @@map("stripe_payment_methods")
}

model StripeProductPriceMap {
  id              String   @id @default(uuid()) @db.Char(36)
  variantId       String   @map("variant_id") @db.Char(36)
  currency        String   @db.VarChar(3)
  stripeProductId String   @map("stripe_product_id") @db.VarChar(120)
  stripePriceId   String   @map("stripe_price_id") @db.VarChar(120)
  fingerprint     String   @db.VarChar(255)
  syncedAt        DateTime @map("synced_at") @db.DateTime(3)
  createdAt       DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([variantId, currency])
  @@index([currency, syncedAt])
  @@map("stripe_product_price_map")
}

model WebhookEvent {
  id            String       @id @default(uuid()) @db.Char(36)
  provider      String       @db.VarChar(40)
  eventId       String       @map("event_id") @db.VarChar(191)
  eventType     String       @map("event_type") @db.VarChar(120)
  payloadHash   String       @map("payload_hash") @db.VarChar(255)
  state         WebhookState @default(processing)
  attempts      Int          @default(1)
  nextRetryAt   DateTime?    @map("next_retry_at") @db.DateTime(3)
  correlationId String?      @map("correlation_id") @db.VarChar(120)
  payloadJson   Json         @map("payload_json")
  errorMessage  String?      @map("error_message") @db.VarChar(500)
  processedAt   DateTime?    @map("processed_at") @db.DateTime(3)
  createdAt     DateTime     @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt     DateTime     @updatedAt @map("updated_at") @db.DateTime(3)

  @@unique([provider, eventId])
  @@index([provider, state, nextRetryAt])
  @@map("webhook_events")
}

model EmailMessage {
  id             String             @id @default(uuid()) @db.Char(36)
  templateKey    String             @map("template_key") @db.VarChar(120)
  recipientEmail String             @map("recipient_email") @db.VarChar(191)
  provider       String             @db.VarChar(80)
  status         EmailMessageStatus @default(queued)
  errorMessage   String?            @map("error_message") @db.VarChar(500)
  payloadJson    Json?              @map("payload_json")
  createdAt      DateTime           @default(now()) @map("created_at") @db.DateTime(3)
  sentAt         DateTime?          @map("sent_at") @db.DateTime(3)

  @@index([status, createdAt])
  @@index([recipientEmail])
  @@map("email_messages")
}

model OnboardingSession {
  id           String           @id @default(uuid()) @db.Char(36)
  status       OnboardingStatus @default(started)
  linkedUserId String?          @map("linked_user_id") @db.Char(36)
  locale       String           @db.VarChar(10)
  country      String           @db.VarChar(2)
  state        String?          @db.VarChar(80)
  tokenHash    String           @map("token_hash") @db.VarChar(255)
  expiresAt    DateTime         @map("expires_at") @db.DateTime(3)
  createdAt    DateTime         @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt    DateTime         @updatedAt @map("updated_at") @db.DateTime(3)

  linkedUser         User?                  @relation(fields: [linkedUserId], references: [id], onDelete: SetNull)
  sessionPets        OnboardingSessionPet[]
  answers            OnboardingAnswer[]
  recommendationRuns RecommendationRun[]
  checkoutOrders     CheckoutOrder[]

  @@index([status, expiresAt, updatedAt])
  @@index([linkedUserId])
  @@map("onboarding_sessions")
}

model OnboardingSessionPet {
  id        String   @id @default(uuid()) @db.Char(36)
  sessionId String   @map("session_id") @db.Char(36)
  petId     String   @map("pet_id") @db.Char(36)
  sortOrder Int      @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)

  session OnboardingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  pet     Pet               @relation(fields: [petId], references: [id], onDelete: Cascade)

  @@unique([sessionId, petId])
  @@index([sessionId, sortOrder])
  @@index([petId])
  @@map("onboarding_session_pets")
}

model OnboardingAnswer {
  id         String   @id @default(uuid()) @db.Char(36)
  sessionId  String   @map("session_id") @db.Char(36)
  stepKey    String   @map("step_key") @db.VarChar(120)
  answerJson Json     @map("answer_json")
  createdAt  DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  session OnboardingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, stepKey])
  @@index([sessionId, updatedAt])
  @@map("onboarding_answers")
}

model RecommendationRun {
  id                    String   @id @default(uuid()) @db.Char(36)
  sessionId             String   @map("session_id") @db.Char(36)
  recommendationVersion String   @map("recommendation_version") @db.VarChar(80)
  marketCountry         String   @map("market_country") @db.VarChar(2)
  currency              String   @db.VarChar(3)
  totalDailyGrams       Decimal  @map("total_daily_grams") @db.Decimal(12, 3)
  totalMonthlyGrams     Decimal  @map("total_monthly_grams") @db.Decimal(12, 3)
  createdAt             DateTime @default(now()) @map("created_at") @db.DateTime(3)

  session       OnboardingSession         @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  petResults    RecommendationPetResult[]
  planSnapshots PlanSnapshot[]

  @@index([sessionId, createdAt])
  @@map("recommendation_runs")
}

model RecommendationPetResult {
  id           String   @id @default(uuid()) @db.Char(36)
  runId        String   @map("run_id") @db.Char(36)
  petId        String   @map("pet_id") @db.Char(36)
  dailyGrams   Decimal  @map("daily_grams") @db.Decimal(12, 3)
  monthlyGrams Decimal  @map("monthly_grams") @db.Decimal(12, 3)
  kcalTarget   Int?     @map("kcal_target")
  factorsJson  Json?    @map("factors_json")
  createdAt    DateTime @default(now()) @map("created_at") @db.DateTime(3)

  run RecommendationRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  pet Pet               @relation(fields: [petId], references: [id], onDelete: Restrict)

  @@index([runId])
  @@index([petId])
  @@map("recommendation_pet_results")
}

model PlanSnapshot {
  id             String   @id @default(uuid()) @db.Char(36)
  runId          String   @map("run_id") @db.Char(36)
  snapshotHash   String   @unique @map("snapshot_hash") @db.VarChar(191)
  subtotalAmount Decimal  @map("subtotal_amount") @db.Decimal(12, 2)
  discountAmount Decimal  @map("discount_amount") @db.Decimal(12, 2)
  shippingAmount Decimal? @map("shipping_amount") @db.Decimal(12, 2)
  totalAmount    Decimal  @map("total_amount") @db.Decimal(12, 2)
  currency       String   @db.VarChar(3)
  payloadJson    Json     @map("payload_json")
  createdAt      DateTime @default(now()) @map("created_at") @db.DateTime(3)

  run            RecommendationRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  checkoutOrders CheckoutOrder[]

  @@index([runId])
  @@index([snapshotHash])
  @@map("plan_snapshots")
}

model UserProfile {
  userId               String   @id @map("user_id") @db.Char(36)
  fullName             String   @map("full_name") @db.VarChar(150)
  phone                String?  @db.VarChar(30)
  phoneCountry         String?  @map("phone_country") @db.VarChar(5)
  avatarUrl            String?  @map("avatar_url") @db.VarChar(500)
  deliveryInstructions String?  @map("delivery_instructions") @db.VarChar(1000)
  createdAt            DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt            DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

model UserAddress {
  id        String      @id @default(uuid()) @db.Char(36)
  userId    String      @map("user_id") @db.Char(36)
  type      AddressType
  isDefault Boolean     @default(false) @map("is_default")
  country   String      @db.VarChar(2)
  state     String      @db.VarChar(80)
  city      String      @db.VarChar(120)
  postcode  String      @db.VarChar(30)
  address1  String      @map("address_1") @db.VarChar(255)
  address2  String?     @map("address_2") @db.VarChar(255)
  deletedAt DateTime?   @map("deleted_at") @db.DateTime(3)
  createdAt DateTime    @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime    @updatedAt @map("updated_at") @db.DateTime(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@index([userId, isDefault])
  @@index([userId, deletedAt])
  @@map("user_addresses")
}

model Breed {
  id        String     @id @default(uuid()) @db.Char(36)
  species   PetSpecies
  namePt    String     @map("name_pt") @db.VarChar(120)
  nameEn    String     @map("name_en") @db.VarChar(120)
  size      String?    @db.VarChar(40)
  createdAt DateTime   @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime   @updatedAt @map("updated_at") @db.DateTime(3)

  pets Pet[]

  @@index([species])
  @@map("breeds")
}

model Pet {
  id                 String     @id @default(uuid()) @db.Char(36)
  userId             String?    @map("user_id") @db.Char(36)
  name               String     @db.VarChar(120)
  species            PetSpecies
  breedId            String?    @map("breed_id") @db.Char(36)
  sex                PetSex?
  birthDate          DateTime?  @map("birth_date") @db.Date
  weightKg           Decimal    @map("weight_kg") @db.Decimal(8, 3)
  neutered           Boolean
  activityLevel      String     @map("activity_level") @db.VarChar(40)
  bodyConditionScore Int?       @map("body_condition_score")
  nutritionGoal      String?    @map("nutrition_goal") @db.VarChar(120)
  restrictionsJson   Json?      @map("restrictions_json")
  deletedAt          DateTime?  @map("deleted_at") @db.DateTime(3)
  createdAt          DateTime   @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt          DateTime   @updatedAt @map("updated_at") @db.DateTime(3)

  user                  User?                     @relation(fields: [userId], references: [id], onDelete: SetNull)
  breed                 Breed?                    @relation(fields: [breedId], references: [id], onDelete: SetNull)
  onboardingSessions    OnboardingSessionPet[]
  recommendationResults RecommendationPetResult[]

  @@index([userId, deletedAt])
  @@index([species])
  @@index([breedId])
  @@map("pets")
}
