# VPS public proxy. Copy to .env.proxy next to docker-compose.proxy.yml.
# This file is not used locally. Local API/front/admin do not go through this Caddy.
#
# Hosts (Caddyfile):
#   edenbowls.com            → coming-soon + redirects from /qa-app /qa-admin /qa-api
#   qa.edenbowls.com         → store   ({FRONTEND_UPSTREAM})
#   qa-admin.edenbowls.com   → admin   ({ADMIN_UPSTREAM})
#   qa-api.edenbowls.com     → API     ({API_UPSTREAM})

# Optional: email for Let's Encrypt notifications
LETSENCRYPT_EMAIL=charlesmendes9@gmail.com

# Upstreams on the VPS host (Caddy uses network_mode: host).
# API      -> docker-compose.qa.yml              publishes 127.0.0.1:3000
# Store    -> eden-bowls/docker-compose.frontend.yml  publishes 127.0.0.1:4173
# Admin    -> eden-bowls-admin/docker-compose.admin.yml publishes 127.0.0.1:4174
API_UPSTREAM=127.0.0.1:3000
FRONTEND_UPSTREAM=127.0.0.1:4173
ADMIN_UPSTREAM=127.0.0.1:4174

# Coming-soon pages ship with the proxy (infra/caddy/site):
# index.html    -> edenbowls.com / www.edenbowls.com
# index-br.html -> edenbowls.com.br / www.edenbowls.com.br
