NODE_ENV=development
# Ignored while NODE_ENV is development or test. QA and production send when
# NODE_ENV=production.
SENTRY_DSN=https://b69af1ec1475f698e095aa3177cf2e8a@o4511821123026944.ingest.us.sentry.io/4512183683973120
PORT=3000
MODE=http
# Leave false on the HTTP process. A separate process with MODE=cron runs the jobs.
# MODE=all, or MODE=http with this flag true, runs the scheduler beside HTTP.
ENABLE_BACKGROUND_JOBS=false
LOG_LEVEL=debug
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175

DB_HOST=127.0.0.1
DB_PORT=3310
DB_USER=eden_bowls
DB_PASSWORD=eden_bowls
DB_NAME=eden_bowls
BREEDS_TABLE_NAME=wp_hsr_breeds

# Production boot rejects a blank value, change-this-in-production, and hsr-default-salt.
JWT_AUTH_SECRET_KEY=change-this-in-production
JWT_AUTH_ALGORITHM=HS256
JWT_AUTH_EXPIRES_IN_SECONDS=900
JWT_AUTH_ISSUER=http://localhost:3000

AUTH_REFRESH_TOKEN_TTL_SECONDS=2592000
AUTH_REFRESH_COOKIE_NAME=eden_refresh_token
AUTH_REFRESH_COOKIE_PATH=/api/v1/auth
AUTH_REFRESH_COOKIE_SAME_SITE=lax
AUTH_REFRESH_COOKIE_SECURE=false
AUTH_OTP_TTL_SECONDS=600
AUTH_OTP_MAX_ATTEMPTS=5
AUTH_OTP_RESEND_MAX_ATTEMPTS=3
AUTH_OTP_RESEND_WINDOW_SECONDS=3600
# Production boot rejects a blank value, change-this-in-production, and hsr-default-salt.
AUTH_OTP_PEPPER=

AUTH_SMTP_HOST=smtp-relay.brevo.com
AUTH_SMTP_PORT=587
AUTH_SMTP_USER=
AUTH_SMTP_PASS=
AUTH_SMTP_ENCRYPTION=tls
AUTH_SMTP_AUTH=true
AUTH_MAIL_FROM=
AUTH_MAIL_FROM_NAME=Eden Bowls

STRIPE_API_VERSION=2025-09-30.clover
STRIPE_MAX_RETRIES=2

STRIPE_US_SECRET_KEY=
STRIPE_US_WEBHOOK_SECRET=
STRIPE_US_AUTOMATIC_TAX=true

STRIPE_BR_SECRET_KEY=
STRIPE_BR_WEBHOOK_SECRET=
STRIPE_BR_ENABLED=false
EDEN_RUNTIME=local




NOMINATIM_USER_AGENT=EdenBowlShipping/1.0 (https://edenbowl.com; shipping@edenbowl.com)

# UPS (US shipping). Development may leave credentials empty (quote_mode=fixed).
# EDEN_RUNTIME picks the UPS host. local and qa always use https://wwwcie.ups.com (CIE, no charges):
# UPS_ENV may be cie or empty there, and UPS_ENV=production stops the boot.
# EDEN_RUNTIME=production requires UPS_ENV=production (https://onlinetools.ups.com, real labels).
# The same client id and secret work on both hosts, so this check is what keeps local and QA off production.
# Production requires UPS_CLIENT_ID, UPS_CLIENT_SECRET, and UPS_ACCOUNT_NUMBER.
# A blank value, change-this-in-production, and hsr-default-salt are rejected in production.
UPS_CLIENT_ID=
UPS_CLIENT_SECRET=
UPS_ACCOUNT_NUMBER=
UPS_ENV=cie
UPS_HTTP_TIMEOUT_MS=5000
UPS_TRANSACTION_SRC=eden-bowls
UPS_LABEL_DIR=./data/ups-labels
# Inside docker-compose.backend.yml and docker-compose.qa.yml this is overridden to /app/ups-labels.
# The container mounts ./data read-only, so labels cannot live under /app/data.
# Eden Bowls invoice PDFs (EB-YYYY-NNNNNN). Docker overrides it to /app/invoices, a named volume shared by api and cron.
INVOICE_PDF_DIR=./data/invoices
# Production requires a non-placeholder METRICS_TOKEN. GET /metrics then expects Authorization: Bearer <token>.
METRICS_TOKEN=

ADMIN_EMAILS=
ADMIN_APP_URL=http://localhost:5174
STORE_APP_URL=http://localhost:5173
MAIL_OPS_TO=

GEO_MAXMIND_DB_PATH=./data/GeoLite2-Country.mmdb
GEO_TRUST_PROXY_HEADERS=false
TRUST_PROXY=false

PROFILE_AVATAR_DIR=./public/avatars
PROFILE_AVATAR_PUBLIC_BASE_URL=
FEEDBACK_PHOTO_DIR=./public/feedback-photos
FEEDBACK_PHOTO_PUBLIC_BASE_URL=
PET_PHOTO_DIR=./public/pet-photos
PET_PHOTO_PUBLIC_BASE_URL=
RECIPE_IMAGE_DIR=./public/recipe-images
RECIPE_IMAGE_PUBLIC_BASE_URL=

# Local: docker-compose.yml (MySQL) + npm run dev or docker-compose.backend.yml (API).
# QA VPS: copy .env.qa.example to .env (CORS/issuer/cookie for qa / qa-admin / qa-api), then:
#   docker compose --env-file .env -f docker-compose.qa.yml up -d --build
#   docker compose --env-file .env.proxy -f docker-compose.proxy.yml up -d

# Launch announcement (`npm run life-stage:announce -- --market <BR|US> [--send]`): customers per batch and per
# UTC day. Set the cap at deploy time to the Brevo plan's daily limit; a run stops there and the next one resumes.
LIFE_STAGE_ANNOUNCEMENT_BATCH_SIZE=50
LIFE_STAGE_ANNOUNCEMENT_DAILY_CAP=300

# Emergency switch of the daily stage-change email, per market (default true). false pauses the job in that market
# without touching the announcement or the Meu plano notices; back to true, the next run sends what is pending.
# Restart the api and cron processes after a change.
LIFE_STAGE_CHANGE_EMAIL_ENABLED_BR=true
LIFE_STAGE_CHANGE_EMAIL_ENABLED_US=true

# Company name and postal address in the footer of marketing emails (launch announcement), per market.
# `npm run life-stage:announce -- --send` refuses a market whose _NAME or _STREET is empty.
MAIL_COMPANY_BR_NAME=C. C. J. Lovato Ltda
MAIL_COMPANY_BR_TAX_ID=65.291.985/0001-05
MAIL_COMPANY_BR_STREET=Rua Delmiro Fetter dos Santos, 94
MAIL_COMPANY_BR_COMPLEMENT=Cajuru
MAIL_COMPANY_BR_CITY=Curitiba
MAIL_COMPANY_BR_STATE=PR
MAIL_COMPANY_BR_POSTAL_CODE=82950-130
MAIL_COMPANY_BR_COUNTRY=BR

MAIL_COMPANY_US_NAME=EZER ONE INC (Eden Bowls)
MAIL_COMPANY_US_TAX_ID=
MAIL_COMPANY_US_STREET=6200 NW 2nd Ave
MAIL_COMPANY_US_COMPLEMENT=
MAIL_COMPANY_US_CITY=Boca Raton
MAIL_COMPANY_US_STATE=FL
MAIL_COMPANY_US_POSTAL_CODE=33487-3021
MAIL_COMPANY_US_COUNTRY=USA
